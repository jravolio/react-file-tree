{
  "name": "vscode-file-tree",
  "version": "0.1.0",
  "private": true,
  "description": "VS Code file tree component library for React",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @vscode-file-tree/storybook dev",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "react",
    "file-tree",
    "vscode",
    "component-library"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "typescript-eslint": "^8.58.2"
  }
}
